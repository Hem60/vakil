# Razorpay test-mode credentials (dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Point at the bundled mock during development; swap for https://api.razorpay.com
RAZORPAY_BASE_URL=http://localhost:8080

ANTHROPIC_API_KEY=
VAKIL_DRAFT_MODEL=claude-opus-5
VAKIL_EXTRACT_MODEL=claude-sonnet-5

DATABASE_URL=postgresql://vakil:vakil@localhost:5432/vakil

# Fight-or-Fold economics (paise)
VAKIL_REPRESENTMENT_COST=25000
VAKIL_ARBITRATION_EXPOSURE=80000
# Merchant dispute ratio and the VAMP threshold it is measured against
VAKIL_DISPUTE_RATIO=0.0040
VAKIL_VAMP_THRESHOLD=0.0090
# Auto-file below this amount when confidence is high (paise)
VAKIL_AUTOFILE_MAX_AMOUNT=1000000
VAKIL_AUTOFILE_MIN_CONFIDENCE=0.75
